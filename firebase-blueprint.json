{
  "entities": {
    "Prompt": {
      "title": "Prompt",
      "description": "A prompt with a visual example.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The title of the prompt." },
        "content": { "type": "string", "description": "The actual prompt text." },
        "exampleUrl": { "type": "string", "description": "URL to a visual example (image/video)." },
        "category": { "type": "string", "description": "Category for filtering." },
        "type": { "type": "string", "enum": ["image", "video"], "description": "Type of prompt (image or video)." },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Tags for searching." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "authorUid": { "type": "string" },
        "linkedPromptId": { "type": "string", "description": "ID of a linked prompt (e.g., video version)." }
      },
      "required": ["title", "content", "authorUid"]
    },
    "User": {
      "title": "User",
      "description": "User profile.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "favoritePromptIds": { "type": "array", "items": { "type": "string" }, "description": "List of favorite prompt IDs." }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/prompts/{promptId}": {
      "schema": "Prompt",
      "description": "Collection of prompts."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles."
    }
  }
}
