rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: prompts
    // Fields:
    //   - title: string (required)
    //   - content: string (required)
    //   - exampleUrl: string (optional)
    //   - category: string (optional)
    //   - type: string (required, ['image', 'video'])
    //   - tags: list (optional)
    //   - createdAt: timestamp
    //   - updatedAt: timestamp
    //   - authorUid: string (required)
    //   - linkedPromptIds: list (optional)
    //
    // Collection: categories
    // Fields:
    //   - name: string (required)
    //
    // Collection: users
    // Fields:
    //   - email: string (required)
    //   - role: string (optional, ['admin', 'user']; set by admins only)
    //   - displayName: string
    //   - favoritePromptIds: list (optional)
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Owner email is a permanent admin (keep in sync with src/lib/admin.ts);
    // other admins are granted via users/{uid}.role == 'admin' by an existing admin.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == "mme.creo@lidera.agency" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin'
      );
    }

    function isPromptAuthor() {
      return isAuthenticated() && resource.data.authorUid == request.auth.uid;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isValidPrompt(data) {
      return data.keys().hasAll(['title', 'content', 'authorUid', 'type']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.content is string && data.content.size() > 0 && data.content.size() < 10000 &&
             data.type in ['image', 'video'] &&
             (!('exampleUrl' in data) || data.exampleUrl == null || (data.exampleUrl is string && data.exampleUrl.size() < 10000000)) &&
             (!('category' in data) || data.category == null || (data.category is string && data.category.size() < 50)) &&
             (!('tags' in data) || data.tags == null || (data.tags is list && data.tags.size() < 20)) &&
             (!('linkedPromptIds' in data) || data.linkedPromptIds == null || (data.linkedPromptIds is list && data.linkedPromptIds.size() < 20));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email']) &&
             data.email is string &&
             (!('role' in data) || data.role in ['admin', 'user']) &&
             (!('favoritePromptIds' in data) || data.favoritePromptIds == null || (data.favoritePromptIds is list && data.favoritePromptIds.size() < 500));
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Users can't grant themselves a role; only admins change roles.
      allow create: if isOwner(userId) && !('role' in request.resource.data) && isValidUser(request.resource.data);
      allow update: if isValidUser(request.resource.data) && (
        (isOwner(userId) && !changedKeys().hasAny(['role'])) || isAdmin()
      );
    }

    match /prompts/{promptId} {
      allow read: if true; // Publicly readable for the library
      allow create: if isAuthenticated() &&
                       request.resource.data.authorUid == request.auth.uid &&
                       isValidPrompt(request.resource.data);
      // Authors edit their own prompts, admins edit any; authorship can't be reassigned.
      // Any signed-in user may bump copyCount by exactly one (and nothing else).
      allow update: if isAuthenticated() && (
        ((isPromptAuthor() || isAdmin()) &&
          request.resource.data.authorUid == resource.data.authorUid &&
          isValidPrompt(request.resource.data)) ||
        (changedKeys().hasOnly(['copyCount']) &&
          request.resource.data.copyCount == resource.data.get('copyCount', 0) + 1)
      );
      allow delete: if isPromptAuthor() || isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
  }
}
